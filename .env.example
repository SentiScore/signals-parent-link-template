# Public StockDashboard origin used by the optional crossover link.
NEXT_PUBLIC_SITE_URL=https://stockdashboard.com

# 1 = render pages without a valid link token (local review only). NEVER set in production.
SIGNALS_PREVIEW=1

# GA4 measurement id (G-XXXXXXX). Leave empty locally.
NEXT_PUBLIC_GA_ID=

# BST-DB ingestion endpoint (POST, JSON). Leave empty locally (events log to the console).
NEXT_PUBLIC_EVENTS_ENDPOINT=
