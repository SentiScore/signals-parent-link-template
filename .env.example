# Public StockDashboard origin used by the crossover link.
NEXT_PUBLIC_SITE_URL=https://stockdashboard.com

# 1 = render pages without a valid link token (local review only). NEVER set in production.
SIGNALS_PREVIEW=1

# Optional: endpoint that receives parent_open / child_open / crossover_home events.
NEXT_PUBLIC_EVENTS_ENDPOINT=
