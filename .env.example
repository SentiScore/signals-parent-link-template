# Public StockDashboard origin for the StockDashboard section on every page.
NEXT_PUBLIC_SITE_URL=https://stockdashboard.com

# 1 = local review: gallery at /, hit viewer at /api/hits, dev signing secret allowed. NEVER in production.
SIGNALS_PREVIEW=1

# Signs every link (long random string). Required in production; changing it invalidates every link ever minted.
LINK_SECRET=

# BST-DB hit ingestion endpoint (POST, JSON). Empty = hits kept in memory and shown at /api/hits.
HITS_ENDPOINT=

# Shared secret for POST /api/revalidate, called by the content agent after it writes a company's pages.
REVALIDATE_SECRET=

# GA4 measurement id (G-XXXXXXX). Empty locally.
NEXT_PUBLIC_GA_ID=
